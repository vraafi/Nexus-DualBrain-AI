{
  "version": "2026.4.26",
  "gateway": {
    "port": 18789,
    "host": "127.0.0.1"
  },
  "workspace": "~/.openclaw",
  "skills": [
    "~/.openclaw/skills"
  ],
  "memory": {
    "path": "~/.openclaw/memory",
    "autoSave": true,
    "clientMemoryDir": "~/.openclaw/memory/clients"
  },
  "browser": {
    "mode": "extension-relay",
    "extensionRelayPort": 18792,
    "managedPort": 18800,
    "defaultMode": "extension-relay",
    "timeout": 30000
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "chatId": "${TELEGRAM_CHAT_ID}",
      "commands": ["/status", "/pause", "/resume", "/earnings", "/jobs", "/help"]
    }
  },
  "llm": {
    "provider": "gemini",
    "model": "gemini-2.5-flash",
    "apiKey": "${GEMINI_KEY_1}",
    "fallbackModel": "gemini-2.0-flash",
    "temperature": 0.2,
    "maxTokens": 8192
  },
  "nodes": {
    "nexus-main": {
      "description": "Nexus DualBrain AI — Autonomous Freelance Agent",
      "skills": [
        "01-upwork-search",
        "02-fiverr-orders",
        "03-freelancer-search",
        "04-negotiate",
        "05-codegen",
        "06-sandbox-test",
        "07-deliver",
        "08-memory-client"
      ],
      "tools": ["browser", "exec", "read", "write", "fetch"]
    }
  },
  "scheduler": {
    "enabled": true,
    "timezone": "Asia/Jakarta",
    "restHours": { "start": 11, "end": 17 },
    "activeHours": { "start": 17, "end": 11 }
  }
}
