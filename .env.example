# ─── Gemini API Keys (minimal 1, maksimal 10 untuk rotasi) ───
GEMINI_KEY_1=your_gemini_api_key_here
GEMINI_KEY_2=your_second_key_optional

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Identity Vault (enkripsi kredensial platform) ───
VAULT_PASSWORD=ganti_dengan_password_kuat_kamu

# ─── PERBAIKAN #3: Email Monitor — WAJIB diisi agar EmailMonitor aktif ───
# Gunakan Gmail App Password (bukan password biasa Gmail)
# Cara buat App Password: myaccount.google.com → Security → App Passwords
EMAIL_ADDRESS=emailkamu@gmail.com
EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_CHECK_INTERVAL=300

# ─── Opsional ───
# Uncomment jika ingin browser tampil (untuk debug login manual)
# HEADLESS=false
