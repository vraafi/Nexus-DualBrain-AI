# ─────────────────────────────────────────────────────────────────────────────
# Nexus DualBrain AI — Contoh file konfigurasi
# Salin file ini ke .env lalu isi dengan nilai asli kamu:
#   cp .env.example .env
#   nano .env
# ─────────────────────────────────────────────────────────────────────────────

# ── GEMINI API KEYS (rotasi otomatis, minimal 1 wajib diisi) ─────────────────
GEMINI_KEY_1=ISI_API_KEY_GEMINI_1
GEMINI_KEY_2=ISI_API_KEY_GEMINI_2
# GEMINI_KEY_3= ... dst sampai GEMINI_KEY_10

# ── BROWSER / BRAVE ───────────────────────────────────────────────────────────
#
# OPSI 1 (DIREKOMENDASIKAN): Connect ke Brave yang sudah berjalan via CDP
# Jalankan Brave dulu dengan perintah:
#   brave-browser --remote-debugging-port=9222 --remote-debugging-address=0.0.0.0
# Lalu isi URL CDP di bawah:
BRAVE_CDP_URL=http://127.0.0.1:9222
#
# OPSI 2: Tunjuk langsung path executable Brave (jika tidak pakai CDP)
# BRAVE_PATH=/usr/bin/brave-browser
#
# Jika keduanya tidak diisi, otomatis pakai Playwright Chromium sebagai fallback.

# ── TELEGRAM (untuk notifikasi & command) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=ISI_BOT_TOKEN
TELEGRAM_CHAT_ID=@username_atau_chat_id

# ── EMAIL (untuk monitor inbox freelance) ────────────────────────────────────
EMAIL_ADDRESS=email@gmail.com
EMAIL_APP_PASSWORD=ISI_APP_PASSWORD_GMAIL
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_CHECK_INTERVAL=300

# ── PAYMENT (DodoPay) ────────────────────────────────────────────────────────
DODO_API_KEY=ISI_DODO_API_KEY
DODO_WEBHOOK_SECRET=whsec_ISI_WEBHOOK_SECRET
PAYMENT_PORTAL_URL=https://domain-kamu.pages.dev/api/webhook

# ── VAULT ────────────────────────────────────────────────────────────────────
VAULT_PASSWORD=ISI_VAULT_PASSWORD

# ── OPSIONAL ─────────────────────────────────────────────────────────────────
# TARGET_HOURLY_RATE=35
# RESIDENTIAL_PROXIES=socks5://user:pass@host:port
