# ════════════════════════════════════════════════════════
# NEXUS DUALBRAIN AI — Environment Variables
# Salin file ini ke .env dan isi semua nilai yang wajib
# ════════════════════════════════════════════════════════

# ─── Gemini API Keys (minimal 1, maksimal 10 untuk rotasi) ───
# Dapatkan di: https://aistudio.google.com/apikey
GEMINI_KEY_1=your_gemini_api_key_here
GEMINI_KEY_2=your_second_key_optional
# GEMINI_KEY_3=...hingga GEMINI_KEY_10

# ─── OpenClaw Gateway (AI Agent Controller) ───
# Dapatkan API key di: https://app.getopenclaw.ai
# OPENCLAW_API_KEY dibutuhkan untuk fitur command full (/pause, /resume, conversational AI)
# Jika kosong: otomatis fallback ke Telegram direct (fitur lebih terbatas)
OPENCLAW_API_KEY=your_openclaw_api_key_here
OPENCLAW_GATEWAY_URL=https://api.getopenclaw.ai

# ─── Telegram Bot (wajib untuk notifikasi) ───
# Buat bot di: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Identity Vault (enkripsi kredensial platform) ───
# Gunakan password yang kuat (minimal 16 karakter)
VAULT_PASSWORD=ganti_dengan_password_kuat_minimal_16_karakter

# ─── Email Monitor (opsional tapi disarankan) ───
# Pakai Gmail App Password, BUKAN password Gmail biasa
# Cara: myaccount.google.com → Security → App Passwords
EMAIL_ADDRESS=emailkamu@gmail.com
EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_CHECK_INTERVAL=300

# ─── Browser Mode (opsional, untuk debug) ───
# Uncomment untuk lihat browser saat agent jalan (berguna saat debug CAPTCHA)
# HEADLESS=false
